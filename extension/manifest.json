{
  "manifest_version": 3,
  "name": "GunsNPrices: Gun & Ammo Specs",
  "short_name": "GunsNPrices",
  "version": "1.0.0",
  "description": "Finds gun and ammo products in an email (order confirmations, deal newsletters) and shows caliber, model, capacity, barrel length, rounds and cost per round. Offline.",
  "author": "GunsNPrices",
  "homepage_url": "https://gunsnprices.com/developers",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thunderbird@gunsnprices.com",
      "strict_min_version": "140.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "message_display_action": {
    "default_title": "Gun & ammo specs in this message",
    "default_label": "Gun & ammo specs",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["messagesRead", "menus"]
}
